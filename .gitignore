# ローカルの参照資料はバージョン管理しない
/references/

# 配布コード、生成設定、ローカルIDEのビルド出力
/src/pneutouch-solist-ai/vendor/
/src/pneutouch-solist-ai/generated/
/src/pneutouch-solist-ai/Debug/
/src/pneutouch-solist-ai/Release/
.metadata/

# ローカルの計測データと開発環境
/captures/
/build/
/.venv/
__pycache__/
*.pyc
.DS_Store

# Main PneutouchAi project build outputs
/src/pneutouch-solist/Debug/
/src/pneutouch-solist/Release/

# 大会用の動画素材はバージョン管理しない
/videos/rehc2026/

# 3D モデルのうち 10 MB 以上のもの（Fusion ファイルと加工前の元 STL）はバージョン管理しない
/3d-models/**/*.f3d
/3d-models/new-dinasour-filled.stl

# Android アプリのビルド出力とローカル設定（Gradle wrapper は管理対象）
/android/.gradle/
/android/.kotlin/
/android/**/build/
/android/local.properties
/android/.idea/
/android/captures/
*.iml
*.apk
*.aab
